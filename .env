# === Database ===
DATABASE_URL=postgresql+asyncpg://etlnexus:password@db:5432/ui_catalog_db
# Prod: set a strong password, must match POSTGRES_PASSWORD below
POSTGRES_PASSWORD=password
# PostgreSQL container database name and user (used by docker-compose)
POSTGRES_DB=ui_catalog_db
POSTGRES_USER=etlnexus
# Connection pool tuning (backend only)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
# DB_ECHO=false

# === Spark Connect (Iceberg catalog access) ===
# Backend reads Iceberg table schemas through a Spark Connect server (no REST catalog).
# Dev: the spark-connect container. Prod: set to your Spark Connect endpoint.
SPARK_CONNECT_URL=sc://spark-connect:15002
# Spark catalog alias holding the Iceberg tables (used in SQL: <catalog>.<ns>.<table>)
SPARK_CATALOG_NAME=spark_catalog
SPARK_NAMESPACE_PREFIX=
# Iceberg hadoop-catalog warehouse path, shared by the Spark Connect server and seeds
SPARK_WAREHOUSE=/tmp/warehouse
# How often the backend polls Spark Connect to refresh the Postgres catalog mirror.
# End users read schemas from Postgres; the mirror is updated this often.
CATALOG_MIRROR_INTERVAL_SECONDS=30
# Max seconds to wait for a Spark Connect read before abandoning a refresh cycle
# (must be < CATALOG_MIRROR_INTERVAL_SECONDS so a hung server can't stall refreshes).
CATALOG_MIRROR_SPARK_TIMEOUT_SECONDS=25

# === Consume snippets (string templates with formatting spots) ===
# Per-table snippet — placeholders: {namespace} (team lowercased), {table}. Literal \n for newlines.
CONSUME_SNIPPET_TABLE_TEMPLATE=from etls import Catalog, Engine\n\nCatalog(Engine.Spark).iceberg.{namespace}.{table}("date").consume().as_pyspark()
# Product-level snippet — placeholder: {product} (data product name).
CONSUME_SNIPPET_PRODUCT_TEMPLATE=from etls import Catalog, Engine\n\nCatalog(Engine.Spark).read_by_tag.{product}("date").consume().as_pyspark()

# === AI / LLM ===
# Set your OpenAPI-compatible endpoint (e.g., https://api.openai.com/v1)
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=default
LLM_MAX_TOKENS=0
LLM_TIMEOUT_SECONDS=0
LLM_VERIFY_SSL=false

# === MCP (AI Architect → Postgres, read-only catalog views) ===
MCP_ENABLED=false
MCP_SERVER_URL=http://db-mcp:8000/sse
MCP_MAX_TOOL_ITERATIONS=5
MCP_TOOL_TIMEOUT_SECONDS=20
MCP_DB_PASSWORD=mcp_readonly_pw

# === Cache & Pagination ===
CACHE_TTL_SHORT=30
CACHE_TTL_MEDIUM=60
DEFAULT_PAGE_LIMIT=200
DEFAULT_PAGE_LIMIT_SMALL=20

# === App ===
# Prod: set to your frontend domain (e.g., ["https://etlnexus.company.com"])
CORS_ORIGINS=["http://localhost:5173"]
DEBUG=true

# Master admins (superusers): comma-separated Keycloak usernames who can edit
# every product across all teams and manage any team's membership. (alice is set
# here for the demo — change to whoever should be a superuser, or leave empty.)
MASTER_ADMIN_USERNAMES=alice

# === SSO / OIDC (Keycloak) ===
# SSO_ISSUER_URL / SSO_PUBLIC_ISSUER_URL must match your Keycloak realm URL
# In production, both should point to the public-facing Keycloak URL
SSO_ENABLED=true
SSO_ISSUER_URL=http://keycloak:8090/realms/etlnexus
SSO_CLIENT_ID=etlnexus-app
SSO_AUDIENCE=etlnexus-app
SSO_GROUPS_CLAIM=groups
SSO_ROLE_CLAIM=realm_access.roles
SSO_ADMIN_ROLE=admin
SSO_PUBLIC_ISSUER_URL=http://localhost:8090/realms/etlnexus
