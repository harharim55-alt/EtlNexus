# =============================================================================
# Two-service stack (backend + frontend). Everything below points at EXISTING
# external services — this stack creates no database, IdP, Spark, or LLM.
#
# TLS: terminated at your external load balancer / ingress. The containers serve
# plain HTTP behind it (frontend on :80, backend on :8000) — do NOT change those.
# Use https:// in every PUBLIC url below (CORS_ORIGINS, SSO_*_ISSUER_URL,
# CSP_CONNECT_SRC) and register https redirect URIs in your IdP. The SPA picks up
# https automatically (its redirect = the browser's origin).
# =============================================================================

# === Database (external PostgreSQL) ===
# Either set the parts below (compose assembles DATABASE_URL from them) or set a full
# DATABASE_URL here and delete the DATABASE_URL line from docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://user:password@your-pg-host:5432/your_db
POSTGRES_HOST=your-pg-host
POSTGRES_DB_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=your_db
# Connection pool tuning (backend only)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
DB_COMMAND_TIMEOUT=30
# DB_ECHO=false
# Schema for the app's OWN tables (ui_catalog_data_products, ui_catalog_product_revisions).
# Created here; all queries are schema-qualified (no search_path — pooler-safe). Default
# "public"; set to your schema (server -> db -> schema -> table).
DB_SCHEMA=public
# asyncpg prepared-statement cache. Set 0 behind a TRANSACTION-pooling PgBouncer (and
# append "?prepared_statement_cache_size=0" to DATABASE_URL). 100 = direct/session pooling.
DB_STATEMENT_CACHE_SIZE=100
# CREATE DATABASE on startup. Set FALSE for an existing/managed DB (it must already
# exist) — the app then only creates its own schema + tables.
DB_CREATE_DATABASE=false

# === Spark Connect (external) ===
# Endpoint of your Spark Connect server; schemas are read live, on demand.
SPARK_CONNECT_URL=sc://your-spark-connect-host:15002
# Catalog holding the Iceberg tables (fqn: <catalog>.<namespace>.<table>).
SPARK_CATALOG_NAME=spark_catalog
# External, read-only Postgres table listing which Iceberg tables exist (db_name +
# tbl_name + date). The app only READS it. Listings filter to ICEBERG_METRICS_DAY_OFFSET.
ICEBERG_METRICS_TABLE=iceberg_table_metrics
# Schema of that table. Empty = default to DB_SCHEMA (or public). Set "public" if it's there.
ICEBERG_METRICS_SCHEMA=
# Only list tables whose `date` = (today - N days), DB-side. 1 = yesterday (default).
ICEBERG_METRICS_DAY_OFFSET=1
# TTL (seconds) for the in-process cache of a single table's live schema.
TABLE_SCHEMA_CACHE_TTL=60

# === Consume snippets ===
# Per-table snippet. Placeholders: {namespace} (team lowercased), {table}. Literal \n for newlines.
CONSUME_SNIPPET_TABLE_TEMPLATE=from etls import Catalog, Engine\n\nCatalog(Engine.Spark).iceberg.{namespace}.{table}("date").consume().as_pyspark()
# Product-level snippet. Placeholder: {product} = data product name.
CONSUME_SNIPPET_PRODUCT_TEMPLATE=from etls import Catalog, Engine\n\nCatalog(Engine.Spark).read_by_tag.{product}("date").consume().as_pyspark()

# === AI / LLM (external endpoint) ===
LLM_API_BASE_URL=https://your-llm-endpoint/v1
LLM_API_KEY=
LLM_MODEL=default
# Max response tokens. 0 = unlimited (model's own max).
LLM_MAX_TOKENS=0
# Request timeout in seconds. 0 = no timeout.
LLM_TIMEOUT_SECONDS=0
# Verify the LLM endpoint's TLS cert. Off for internal/self-signed.
LLM_VERIFY_SSL=false
# Opening message in the AI Architect chat.
AI_GREETING=Hello! I am your AI Data Architect. You can ask me about the existing data products or look for a data product that matches your needs. Where would you like to start?
# How long the browser waits for an AI reply (single long-blocking request). Keep <= API_PROXY_READ_TIMEOUT.
AI_REQUEST_TIMEOUT_SECONDS=300

# === Cache & Pagination ===
CACHE_TTL_SHORT=30
CACHE_TTL_MEDIUM=60
DEFAULT_PAGE_LIMIT=200
DEFAULT_PAGE_LIMIT_SMALL=20

# === App ===
# Your frontend origin(s) over HTTPS (JSON list) — the public URL(s) users load.
CORS_ORIGINS=["https://etlnexus.company.com"]
DEBUG=false
DEPLOYMENT_ENV=production
# Login-page branding. APP_NAME = system name; APP_OWNER = "Made by …" credit (empty
# hides it). Reaches the React login screen via /api/auth/config. (Your external
# Keycloak login page is themed on Keycloak itself.) Avoid the '|' character.
APP_NAME=ETL Nexus
APP_OWNER=
# Master admins (superusers): comma-separated Keycloak usernames. Empty = none.
MASTER_ADMIN_USERNAMES=
# Teams allowed (from Keycloak groups). JSON list e.g. ["Dagger","Vault"], or ["*"] for all.
SYSTEM_TEAMS=["*"]
# Number of trusted reverse-proxy hops in X-Forwarded-For (for client-IP / rate limiting).
# Behind an external LB (1) + the bundled frontend nginx (1) that also proxies /api = 2.
TRUSTED_PROXY_DEPTH=2
LOG_FORMAT=auto
MAX_REQUEST_BODY_BYTES=1048576
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_AI=60/minute

# === SSO / OIDC (external Keycloak / IdP) ===
# SSO_ISSUER_URL = URL the BACKEND reaches (JWKS); SSO_PUBLIC_ISSUER_URL = URL the
# BROWSER reaches. Often the same public realm URL.
SSO_ENABLED=true
SSO_ISSUER_URL=https://your-idp/realms/your-realm
SSO_CLIENT_ID=etlnexus-app
SSO_AUDIENCE=etlnexus-app
SSO_GROUPS_CLAIM=groups
# Rename SSO groups to system team names (JSON dict). Keys = group name from the token
# (with or without a leading "/"); values = the name shown in the app. Empty = no rename.
# e.g. SSO_GROUP_MAP={"kc-dagger-team":"Dagger","/vault-grp":"Vault"}
SSO_GROUP_MAP={}
SSO_PUBLIC_ISSUER_URL=https://your-idp/realms/your-realm
# Secret for a CONFIDENTIAL client. The SPA runs the OIDC flow, so this is delivered to
# the browser and sent on the token exchange. Leave empty for a public client.
# SECURITY: a browser-exposed secret gives no real protection — only use for an internal
# app whose IdP mandates a confidential client.
SSO_CLIENT_SECRET=
OIDC_HTTP_TIMEOUT_SECONDS=10
JWKS_CACHE_TTL_SECONDS=21600
# TLS to the IdP (backend fetches .well-known + JWKS over HTTPS).
#   OIDC_VERIFY_SSL=false -> skip verification entirely (insecure; testing only). Ignores OIDC_CA_BUNDLE.
#   OIDC_VERIFY_SSL=true  -> verify. For a private/internal CA, mount the CA PEM into the backend
#                            container and set OIDC_CA_BUNDLE to its path (keeps verification ON — preferred).
OIDC_VERIFY_SSL=true
OIDC_CA_BUNDLE=

# === Frontend / Compose ===
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Browser Content-Security-Policy connect-src for the frontend nginx. MUST include your
# Keycloak origin (and any other origin the SPA calls), e.g.:
#   CSP_CONNECT_SRC=https://your-idp
CSP_CONNECT_SRC=
# Frontend nginx /api proxy timeouts (nginx units). Must be >= AI_REQUEST_TIMEOUT_SECONDS.
API_PROXY_READ_TIMEOUT=300s
API_PROXY_SEND_TIMEOUT=300s
# Container memory limits + log rotation.
BACKEND_MEMORY_LIMIT=2G
FRONTEND_MEMORY_LIMIT=256M
LOG_MAX_SIZE=50m
LOG_MAX_FILES=5
LOG_MAX_SIZE_SMALL=10m
LOG_MAX_FILES_SMALL=3
