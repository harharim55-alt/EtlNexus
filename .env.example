# === Database ===
DATABASE_URL=postgresql+asyncpg://etlnexus:password@db:5432/ui_catalog_db
# Prod: set a strong password, must match POSTGRES_PASSWORD below
POSTGRES_PASSWORD=password
# PostgreSQL container database name and user (used by docker-compose)
POSTGRES_DB=ui_catalog_db
POSTGRES_USER=etlnexus
# Connection pool tuning (backend only)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
DB_COMMAND_TIMEOUT=30
# DB_ECHO=false

# === Spark Connect (Iceberg catalog access) ===
# Backend reads Iceberg table schemas through a Spark Connect server (no REST catalog).
# Dev: the spark-connect container. Prod: set to your Spark Connect endpoint.
SPARK_CONNECT_URL=sc://spark-connect:15002
# Spark catalog alias holding the Iceberg tables (used in SQL: <catalog>.<ns>.<table>)
SPARK_CATALOG_NAME=iceberg
SPARK_NAMESPACE_PREFIX=dagger,prism,vault,oasis
# Iceberg hadoop-catalog warehouse path, shared by the Spark Connect server and seeds
SPARK_WAREHOUSE=/tmp/warehouse
# --- Bundled Spark Connect server (dev/export container) ---
# Host port the spark-connect container publishes (container side stays 15002).
SPARK_CONNECT_PORT=15002
# Spark / Iceberg runtime versions the server loads via --packages.
SPARK_CONNECT_VERSION=3.5.1
ICEBERG_VERSION=1.7.1
# Ivy cache dir inside the container (where --packages are resolved).
SPARK_IVY_DIR=/opt/spark/.ivy2
# How often the backend polls Spark Connect to refresh the Postgres catalog mirror.
# End users read schemas from Postgres; the mirror is updated this often.
CATALOG_MIRROR_INTERVAL_SECONDS=30
# Max seconds to wait for a Spark Connect read before abandoning a refresh cycle
# (must be < CATALOG_MIRROR_INTERVAL_SECONDS so a hung server can't stall refreshes).
CATALOG_MIRROR_SPARK_TIMEOUT_SECONDS=25

# === Consume snippets ===
# Per-table snippet (Tables page + each table tab of a data product). Placeholders:
#   {namespace} catalog namespace (team lowercased), {table} table name. Literal \n for newlines.
CONSUME_SNIPPET_TABLE_TEMPLATE=from etls import Catalog, Engine\n\nCatalog(Engine.Spark).iceberg.{namespace}.{table}("date").consume().as_pyspark()
# Product-level snippet (the whole data product). Placeholder: {product} = data product name.
CONSUME_SNIPPET_PRODUCT_TEMPLATE=from etls import Catalog, Engine\n\nCatalog(Engine.Spark).read_by_tag.{product}("date").consume().as_pyspark()

# === AI / LLM ===
# Set your OpenAPI-compatible endpoint (e.g., https://api.openai.com/v1)
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=default
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30

# === MCP (AI Architect → Postgres) ===
# When enabled, the AI chat can query the catalog DB via the db-mcp server using
# LLM tool calls (read-only, mcp schema views only — no PII). Requires a
# tool-calling-capable LLM_API_BASE_URL.
MCP_ENABLED=true
MCP_SERVER_URL=http://db-mcp:8000/sse
MCP_MAX_TOOL_ITERATIONS=5
MCP_TOOL_TIMEOUT_SECONDS=20
# Postgres MCP server image (db-mcp service)
MCP_IMAGE=crystaldba/postgres-mcp:latest
# Password for the read-only mcp_readonly Postgres role (created by migration 048,
# used by the db-mcp container). Change in production.
MCP_DB_PASSWORD=mcp_readonly_pw

# === Cache & Pagination ===
CACHE_TTL_SHORT=30
CACHE_TTL_MEDIUM=60
DEFAULT_PAGE_LIMIT=200
DEFAULT_PAGE_LIMIT_SMALL=20

# === App ===
# Prod: set to your frontend domain (e.g., ["https://etlnexus.company.com"])
CORS_ORIGINS=["http://localhost:5173"]
DEBUG=true
DEPLOYMENT_ENV=development
# Master admins (superusers): comma-separated Keycloak usernames who can edit
# every product across all teams and manage any team's membership. Empty = none.
MASTER_ADMIN_USERNAMES=
# Teams that exist in the system (sourced from Keycloak groups). JSON list, e.g.
# ["Dagger","Vault"] — only these groups become teams and they are pre-created at
# startup. Use ["*"] to allow every Keycloak group (teams created on first login).
SYSTEM_TEAMS=["*"]
TRUSTED_PROXY_DEPTH=1
SCHEDULER_ENABLED=true
LOG_FORMAT=auto
# Reject requests with a Content-Length larger than this (bytes).
MAX_REQUEST_BODY_BYTES=1048576
# Per-client rate limits (slowapi syntax, e.g. "200/minute").
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_AI=60/minute

# === SSO / OIDC ===
# SSO_ISSUER_URL / SSO_PUBLIC_ISSUER_URL must match your OIDC realm URL.
# In production these point at your real, external IdP (the bundled Keycloak
# below is DEV ONLY). Both should be the public-facing URL in prod.
SSO_ENABLED=true
SSO_ISSUER_URL=http://keycloak:8090/realms/etlnexus
SSO_CLIENT_ID=etlnexus-app
SSO_AUDIENCE=etlnexus-app
SSO_GROUPS_CLAIM=groups
SSO_ROLE_CLAIM=realm_access.roles
SSO_ADMIN_ROLE=admin
SSO_PUBLIC_ISSUER_URL=http://localhost:8090/realms/etlnexus
# OIDC HTTP client tuning
OIDC_HTTP_TIMEOUT_SECONDS=10
JWKS_CACHE_TTL_SECONDS=21600

# === Docker Compose: host ports & hostname ===
# Host name/IP the stack is reached at (drives Keycloak issuer + CORS). Set to
# the machine's IP/hostname when accessing from another host; else localhost.
# HOSTNAME=localhost
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# === Dev-only bundled Keycloak (NOT for production — use an external IdP) ===
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.2
KEYCLOAK_PORT=8090
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# === Production compose tuning (docker-compose.prod.yml only) ===
DB_SHARED_BUFFERS=256MB
DB_WORK_MEM=16MB
DB_EFFECTIVE_CACHE_SIZE=512MB
DB_MAINTENANCE_WORK_MEM=64MB
DB_MAX_CONNECTIONS=200
DB_MEMORY_LIMIT=2G
BACKEND_MEMORY_LIMIT=2G
BACKEND_API_REPLICAS=2
FRONTEND_MEMORY_LIMIT=256M
BACKUP_MEMORY_LIMIT=256M
LOG_MAX_SIZE=50m
LOG_MAX_FILES=5
LOG_MAX_SIZE_SMALL=10m
LOG_MAX_FILES_SMALL=3
